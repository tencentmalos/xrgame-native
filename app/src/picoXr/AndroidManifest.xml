<?xml version="1.0" encoding="utf-8"?>
<!-- Ordinary Android SBS and optional headset OpenXR share the Windows VR bridge. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <!-- Spec WP1-3: games install to /sdcard/XRGameNative so they survive uninstall and
         re-signing. Internal distribution only (spec §9-2), so All files access is acceptable.
         Requested at runtime by app.gamenative.xrgame.XrGameStorage. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <!-- Khronos loader discovery on Android 11+, including the future Swan runtime.
         SBS itself does not create a host OpenXR instance. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- Eye-tracked foveation of the Windows VR reconstruction (XR_EXT_eye_gaze_interaction). -->
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
        <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    </queries>
    <application>
        <activity android:name="app.gamenative.ui.screen.xr.sbs.SbsVrActivity"
            android:exported="false" android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|colorMode"
            android:theme="@style/Theme.Pluvia" />
        <activity android:name="app.gamenative.ui.screen.xr.ImmersiveXrActivity"
            android:exported="false" android:screenOrientation="landscape" android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|colorMode"
            android:theme="@style/Theme.Pluvia">
            <meta-data android:name="pvr.app.type" android:value="vr" />
        </activity>
    </application>
</manifest>
