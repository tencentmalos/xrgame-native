#!/usr/bin/env python3
"""Inventory picoXr native libraries/assets and reject unregistered or changed inputs."""
import argparse
import fnmatch
import hashlib
import json
import re
from pathlib import Path
import struct
import sys
import zipfile


def sha(data):
    return hashlib.sha256(data).hexdigest()


def build_id(data):
    """Read the GNU Build ID from ELF64 PT_NOTE without executing the binary."""
    if data[:6] != b'\x7fELF\x02\x01' or len(data) < 64:
        return None
    phoff = struct.unpack_from('<Q', data, 32)[0]
    phsize, count = struct.unpack_from('<HH', data, 54)
    for index in range(count):
        pos = phoff + index * phsize
        if pos + 56 > len(data) or phsize < 56:
            return None
        kind, _, offset, _, _, size = struct.unpack_from('<IIQQQQ', data, pos)
        if kind != 4 or offset + size > len(data):
            continue
        end = offset + size
        while offset + 12 <= end:
            namesz, descsz, note_type = struct.unpack_from('<III', data, offset)
            name_start = offset + 12
            desc_start = name_start + ((namesz + 3) & ~3)
            next_offset = desc_start + ((descsz + 3) & ~3)
            if next_offset > end:
                break
            if note_type == 3 and data[name_start:name_start + namesz].rstrip(b'\0') == b'GNU':
                return data[desc_start:desc_start + descsz].hex()
            offset = next_offset
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('apk', type=Path)
    parser.add_argument('--registry', type=Path, default=Path(__file__).resolve().parent/'xrgame/apk-sources.json')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--validation-catalog', type=Path, help='Exact private catalog used for a debug validation APK')
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    registry = json.loads(args.registry.read_text())
    files, errors = [], []
    denied = ('libredirect', 'steamhost', 'eahost', 'rgschost', 'steamless', 'libkgslshim',
              'libsteambootstrap', 'libsteamclient', 'libvulkan_wrapper', 'libvortekrenderer')
    with zipfile.ZipFile(args.apk) as apk:
        paths = [entry.filename for entry in apk.infolist() if not entry.is_dir()]
        if len(paths) != len(set(paths)):
            errors.append('APK has duplicate ZIP entries')
        for path in sorted(paths):
            if path.startswith('classes') and path.endswith('.dex'):
                dex = apk.read(path)
                if b'Lcom/samsung/sdk/sperf/' in dex or b'Lcom/meta/horizon/' in dex:
                    errors.append('Proprietary SDK classes found in '+path)
            if not path.startswith(('lib/', 'assets/')):
                continue
            data = apk.read(path)
            row = {'path': path, 'sha256': sha(data), 'size': len(data)}
            if data.startswith(b'\x7fELF'):
                row['buildId'] = build_id(data)
            name = Path(path).name.lower()
            if name.startswith(denied) or name == 'redirect.tzst':
                errors.append('Prohibited component: '+path)
            rules = [rule for rule in registry['rules'] if fnmatch.fnmatchcase(path, rule['pattern'])]
            if len(rules) != 1:
                row['status'] = 'unregistered' if not rules else 'ambiguous'
                errors.append(row['status']+': '+path)
            else:
                rule = rules[0]
                row.update({key: rule[key] for key in ('kind', 'license', 'source')})
                row['status'] = 'verified'
                if 'repositoryPrefix' in rule:
                    prefix = rule['pattern'].split('*')[0]
                    artifact = root/rule['repositoryPrefix']/path[len(prefix):]
                else:
                    artifact = root/rule['artifact'] if 'artifact' in rule else None
                if path == 'assets/xrgame/manifest.json' and args.validation_catalog:
                    artifact = args.validation_catalog
                if rule.get('catalogComponent'):
                    manifest = json.loads(apk.read('assets/xrgame/manifest.json'))
                    entries = [entry for group in manifest['items'].values() for entry in group
                               if entry['url'].rsplit('/', 1)[-1] == name]
                    if len(entries) != 1 or entries[0].get('sha256') != row['sha256']:
                        row['status'] = 'digest-mismatch'
                        errors.append('Bundled component does not match catalog: '+path)
                    else:
                        row.update({key: entries[0][key] for key in ('license', 'source')})
                        row['componentId'] = entries[0]['id']
                elif artifact:
                    original = artifact.read_bytes() if artifact.is_file() else b''
                    same_build = (rule['kind'] == 'repository-build' and row.get('buildId') and
                                  row['buildId'] == build_id(original))
                    if not original or (sha(original) != row['sha256'] and not same_build):
                        row['status'] = 'artifact-mismatch'
                        errors.append('Build/source artifact mismatch: '+path)
                    else:
                        row['artifactSha256'] = sha(original)
                elif row['sha256'] != rule.get('sha256'):
                    row['status'] = 'digest-mismatch'
                    errors.append('Unpinned or changed prebuilt: '+path)
                if not row['license'] or not row['source']:
                    row['status'] = 'missing-provenance'
                    errors.append('Missing license/source: '+path)
            files.append(row)
        for required in registry.get('required', []):
            if required not in paths:
                errors.append('Missing required file: '+required)
        if 'assets/xrgame/manifest.json' in paths:
            items = json.loads(apk.read('assets/xrgame/manifest.json')).get('items', {})
            versions = dict(re.findall(r'String (\w+) = "([^"]+)"',
                (root/'app/src/main/java/app/gamenative/xrgame/XrGameRuntimeVersions.java').read_text()))
            for kind, constant in [('proton', 'WINE'), ('fexcore', 'FEX'), ('dxvk', 'DXVK'),
                                   ('vkd3d', 'VKD3D'), ('driver', 'TURNIP')]:
                if not any(e['id'] == versions[constant] for e in items.get(kind, [])):
                    errors.append('Missing bundled default: '+kind)
            for kind in ['imagefs', 'steamclient']:
                if len(items.get(kind, [])) != 1:
                    errors.append('Missing or ambiguous bundled default: '+kind)
            for group in items.values():
                for entry in group:
                    member = 'assets/xrgame/components/'+entry['url'].rsplit('/', 1)[-1]
                    if member not in paths:
                        errors.append('Missing bundled archive: '+member)
    report = {'apkSha256': sha(args.apk.read_bytes()), 'registrySha256': sha(args.registry.read_bytes()),
              'passed': not errors, 'files': files, 'errors': errors}
    if args.validation_catalog:
        report['validationCatalogSha256'] = sha(args.validation_catalog.read_bytes())
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(report, indent=2, ensure_ascii=False)+'\n')
    print(f'{len(files)} files, {len(errors)} errors; report: {args.output}')
    for error in errors:
        print(error, file=sys.stderr)
    return 1 if errors else 0


if __name__ == '__main__':
    raise SystemExit(main())
