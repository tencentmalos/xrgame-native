+static void *remote_breakin_address(HANDLE process)
+{
+    HMODULE modules[256];
+    DWORD needed, i, j, name_rva, function_rva;
+    WORD ordinal;
+    char name[64];
+    BYTE *base;
+    IMAGE_DOS_HEADER dos;
+    IMAGE_NT_HEADERS64 nt;
+    IMAGE_DATA_DIRECTORY dir;
+    IMAGE_EXPORT_DIRECTORY exports;
+    SIZE_T read;
+
+    if (!EnumProcessModulesEx(process, modules, sizeof(modules), &needed, LIST_MODULES_ALL) ||
+        needed > sizeof(modules)) return NULL;
+    for (i = 0; i < needed / sizeof(modules[0]); i++)
+    {
+        if (!GetModuleBaseNameA(process, modules[i], name, sizeof(name)) ||
+            stricmp(name, "ntdll.dll")) continue;
+        base = (BYTE *)modules[i];
+        if (!ReadProcessMemory(process, base, &dos, sizeof(dos), &read) || read != sizeof(dos) ||
+            dos.e_magic != IMAGE_DOS_SIGNATURE || dos.e_lfanew < 0 || dos.e_lfanew > 0x100000 ||
+            !ReadProcessMemory(process, base + dos.e_lfanew, &nt, sizeof(nt), &read) || read != sizeof(nt) ||
+            nt.Signature != IMAGE_NT_SIGNATURE || nt.OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+            return NULL;
+        dir = nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+        if (!dir.VirtualAddress || dir.Size < sizeof(exports) ||
+            (ULONGLONG)dir.VirtualAddress + dir.Size > nt.OptionalHeader.SizeOfImage ||
+            !ReadProcessMemory(process, base + dir.VirtualAddress, &exports, sizeof(exports), &read) ||
+            read != sizeof(exports) || exports.NumberOfNames > 65536 || exports.NumberOfFunctions > 65536 ||
+            (ULONGLONG)exports.AddressOfNames + exports.NumberOfNames * sizeof(DWORD) > nt.OptionalHeader.SizeOfImage ||
+            (ULONGLONG)exports.AddressOfNameOrdinals + exports.NumberOfNames * sizeof(WORD) > nt.OptionalHeader.SizeOfImage ||
+            (ULONGLONG)exports.AddressOfFunctions + exports.NumberOfFunctions * sizeof(DWORD) > nt.OptionalHeader.SizeOfImage)
+            return NULL;
+        for (j = 0; j < exports.NumberOfNames; j++)
+        {
+            if (!ReadProcessMemory(process, base + exports.AddressOfNames + j * sizeof(DWORD),
+                                   &name_rva, sizeof(name_rva), &read) || read != sizeof(name_rva) ||
+                (ULONGLONG)name_rva + sizeof(name) > nt.OptionalHeader.SizeOfImage ||
+                !ReadProcessMemory(process, base + name_rva, name, sizeof(name), &read) || read != sizeof(name))
+                return NULL;
+            if (memcmp(name, "DbgUiRemoteBreakin", sizeof("DbgUiRemoteBreakin"))) continue;
+            if (!ReadProcessMemory(process, base + exports.AddressOfNameOrdinals + j * sizeof(WORD),
+                                   &ordinal, sizeof(ordinal), &read) || read != sizeof(ordinal) ||
+                ordinal >= exports.NumberOfFunctions ||
+                !ReadProcessMemory(process, base + exports.AddressOfFunctions + ordinal * sizeof(DWORD),
+                                   &function_rva, sizeof(function_rva), &read) || read != sizeof(function_rva) ||
+                !function_rva || function_rva >= nt.OptionalHeader.SizeOfImage ||
+                (function_rva >= dir.VirtualAddress && function_rva < dir.VirtualAddress + dir.Size))
+                return NULL;
+            return base + function_rva;
+        }
+        return NULL;
+    }
+    return NULL;
+}
+
+BOOL dbg_remote_breakin(HANDLE process)
+{
+    HANDLE thread;
+    void *address;
+
+    if (!GetEnvironmentVariableA("WINE_GDB_REMOTE_NTDLL_BREAKIN", NULL, 0))
+        return DebugBreakProcess(process);
+    if (!(address = remote_breakin_address(process)))
+    {
+        SetLastError(ERROR_PROC_NOT_FOUND);
