+        SetLastError(RtlNtStatusToDosError(status));
+        return FALSE;
+    }
+    if (!(process = OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid))) return FALSE;
+    expected_length = GetEnvironmentVariableA("WINE_GDB_EXPECT_UNIX_PID", expected_pid, sizeof(expected_pid));
+    if (expected_length)
+    {
+        if (expected_length >= sizeof(expected_pid))
+        {
+            CloseHandle(process);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        expected = strtoul(expected_pid, &end, 10);
+        if (!expected || *end ||
+            NtQueryInformationProcess(process, ProcessWineUnixPid, &unix_pid, sizeof(unix_pid), NULL) ||
+            unix_pid != expected)
+        {
+            CloseHandle(process);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        fprintf(stderr, "Verified Wine pid %lu -> Unix pid %d\n", pid, unix_pid);
+    }
+    DebugSetProcessKillOnExit(FALSE);
+    status = NtDebugActiveProcess(process, DbgUiGetThreadDebugObject());
+    if (status)
+    {
+        SetLastError(RtlNtStatusToDosError(status));
+        result = FALSE;
+    }
+    else if (!(result = dbg_remote_breakin(process)))
+        DbgUiStopDebugging(process);
+    CloseHandle(process);
+    return result;
+}
