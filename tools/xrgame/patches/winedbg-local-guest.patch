+static BOOL attach_remote_debuggee(DWORD pid)
+{
+    HANDLE process;
+    NTSTATUS status;
+    BOOL result;
+    char expected_pid[32], *end;
+    DWORD expected, expected_length;
+    int unix_pid;
+
+    if (!GetEnvironmentVariableA("WINE_GDB_REMOTE_NTDLL_BREAKIN", NULL, 0))
+        return DebugActiveProcess(pid);
+    if ((status = DbgUiConnectToDbg()))
