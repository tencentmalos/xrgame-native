+static BOOL gdb_remove_swbreak(struct gdb_context *gdbctx, struct gdb_xpoint *x)
+{
+    struct dbg_process *process = gdbctx->process;
+
+    if (!process->be_cpu->remove_Xpoint(process->handle, process->process_io,
+                                      NULL, be_xpoint_break, x->addr, x->value, 0) ||
+        !FlushInstructionCache(process->handle, x->addr, 1))
+        return FALSE;
+    list_remove(&x->entry);
+    free(x);
+    return TRUE;
+}
+
+static BOOL gdb_insert_swbreak(struct gdb_context *gdbctx, void *addr)
+{
+    struct dbg_process *process = gdbctx->process;
+    struct gdb_xpoint *x;
+
+    if (!GetEnvironmentVariableA("WINE_GDB_SOFTWARE_BREAKPOINTS", NULL, 0)) return FALSE;
+    if (gdb_find_xpoint(gdbctx, NULL, be_xpoint_break, addr, 0)) return TRUE;
+    if (!(x = calloc(1, sizeof(*x)))) return FALSE;
+    x->pid = process->pid;
+    x->type = be_xpoint_break;
+    x->addr = addr;
+    if (!process->be_cpu->insert_Xpoint(process->handle, process->process_io,
+                                      NULL, be_xpoint_break, addr, &x->value, 0))
+    {
+        free(x);
+        return FALSE;
+    }
+    list_add_head(&gdbctx->xpoint_list, &x->entry);
+    if (FlushInstructionCache(process->handle, addr, 1)) return TRUE;
+    if (!gdb_remove_swbreak(gdbctx, x))
+        ERR("Cannot roll back software breakpoint at %p\n", addr);
+    return FALSE;
+}
+
+static void gdb_adjust_swbreak_pc(struct gdb_context *gdbctx)
+{
+    struct dbg_process *process = gdbctx->process;
+    struct backend_cpu *cpu = process->be_cpu;
+    struct dbg_thread *thread;
+    void *addr = gdbctx->de.u.Exception.ExceptionRecord.ExceptionAddress;
+    ADDRESS64 pc;
+    dbg_ctx_t ctx;
+
+    if (!gdb_find_xpoint(gdbctx, NULL, be_xpoint_break, addr, 0)) return;
+    thread = dbg_get_thread(process, gdbctx->de.dwThreadId);
+    if (thread && cpu->get_context(thread->handle, &ctx) &&
+        cpu->get_addr(thread->handle, &ctx, be_cpu_addr_pc, &pc) &&
+        cpu->linearize(thread->handle, &pc) == (char *)addr + 1)
+    {
+        cpu->adjust_pc_for_break(&ctx, TRUE);
+        if (!cpu->set_context(thread->handle, &ctx))
+            ERR("Cannot restore software breakpoint PC for thread %04lx\n", thread->tid);
+    }
+}
