+static nir_def *
+tu_fdm_visualize_tint(nir_builder *b, float r, float g, float bl)
+{
+   float luma = 0.2126f * r + 0.7152f * g + 0.0722f * bl;
+   return nir_imm_vec3(b, 0.25f + 0.75f * r / luma,
+                       0.25f + 0.75f * g / luma,
+                       0.25f + 0.75f * bl / luma);
+}
+
+static bool
+tu_nir_visualize_fdm_instr(nir_builder *b, nir_intrinsic_instr *intrin,
+                           void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_store_deref)
+      return false;
+
+   nir_deref_instr *deref = nir_src_as_deref(intrin->src[0]);
+   if (deref->deref_type != nir_deref_type_var ||
+       !nir_deref_mode_is(deref, nir_var_shader_out))
+      return false;
+
+   nir_variable *var = deref->var;
+   if ((var->data.location != FRAG_RESULT_DATA0 &&
+        var->data.location != FRAG_RESULT_COLOR) ||
+       var->data.index != 0)
+      return false;
+
+   enum glsl_base_type base = glsl_get_base_type(var->type);
+   if (base != GLSL_TYPE_FLOAT && base != GLSL_TYPE_FLOAT16)
+      return false;
+
+   nir_def *value = intrin->src[1].ssa;
+   if (value->num_components < 3)
+      return false;
+
+   b->cursor = nir_before_instr(&intrin->instr);
+   nir_def *size = nir_load_frag_size(b);
+   nir_def *area = nir_imul(b, nir_channel(b, size, 0), nir_channel(b, size, 1));
+   nir_def *tint =
+      nir_bcsel(b, nir_ige_imm(b, area, 16), tu_fdm_visualize_tint(b, 1.0f, 0.0f, 0.0f),
+      nir_bcsel(b, nir_ige_imm(b, area, 8), tu_fdm_visualize_tint(b, 1.0f, 0.5f, 0.0f),
+      nir_bcsel(b, nir_ige_imm(b, area, 4), tu_fdm_visualize_tint(b, 1.0f, 1.0f, 0.0f),
+                tu_fdm_visualize_tint(b, 0.0f, 1.0f, 0.0f))));
+   tint = nir_f2fN(b, tint, value->bit_size);
+   nir_def *color = nir_trim_vector(b, value, 3);
+   nir_def *weights =
+      nir_f2fN(b, nir_imm_vec3(b, 0.2126f, 0.7152f, 0.0722f), value->bit_size);
+   nir_def *luma = nir_replicate(b, nir_fdot(b, color, weights), 3);
+   nir_def *rgb = nir_bcsel(b, nir_ige_imm(b, area, 2),
+                            nir_fmul(b, tint, luma), color);
+
+   nir_def *channels[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < value->num_components; i++)
+      channels[i] = i < 3 ? nir_channel(b, rgb, i) : nir_channel(b, value, i);
+   nir_src_rewrite(&intrin->src[1], nir_vec(b, channels, value->num_components));
+   return true;
+}
+
+static bool
+tu_nir_visualize_fdm(nir_shader *shader)
+{
+   return nir_shader_intrinsics_pass(shader, tu_nir_visualize_fdm_instr,
+                                     nir_metadata_control_flow, NULL);
+}
