diff --git a/src/vulkan/wsi/wsi_common_x11_host.inc b/src/vulkan/wsi/wsi_common_x11_host.inc
new file mode 100644
index 0000000..bb51fbc
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_x11_host.inc
@@ -0,0 +1,495 @@
+/* SteamPSP: present an X11 surface through a second, host X server.
+ *
+ * XRGAME_X11_HOST_DISPLAY names the host display (for example ":0"). The
+ * surface stays on its own server, which keeps window management, input and
+ * fonts. The swapchain presents to an override-redirect window on the host
+ * that follows the surface window's root position, size and visibility; the
+ * host skips windows carrying _XRGAME_INPUT_PASSTHROUGH when it routes input, and keeps
+ * windows carrying _XRGAME_STACK_KEY above its own windows in the surface server's order.
+ *
+ * The host allocates every image as an AHardwareBuffer. The DRI3
+ * PixmapFromBuffers request carries modifier XRGAME_HOST_AHB_MODIFIER, the
+ * AHardwareBuffer format in offset0 and one socketpair end; the host answers on
+ * the socketpair with AHardwareBuffer_sendHandleToUnixSocket. The flattened
+ * GraphicBuffer holds the dma-buf, which is imported with the host's linear
+ * stride. As with XRGAME_X11_AHB, fences are CPU-waited before each Present and
+ * IdleNotify returns images; no SYNC fence or xshmfence is used.
+ */
+#include <poll.h>
+#include <sys/socket.h>
+
+#define XRGAME_HOST_AHB_MODIFIER 1256
+/* GraphicBuffer::flatten: magic, width, height, stride, format, layers,
+ * usage, id (2), generation, fd count, int count, usage high, ints... */
+#define XRGAME_GB01 0x47423031
+#define XRGAME_GB01_HEADER 13
+#define XRGAME_GB01_MAX_INTS 256
+#define XRGAME_HOST_MAX_FDS 8
+
+static xcb_connection_t *x11_host_conn;
+static once_flag x11_host_once = ONCE_FLAG_INIT;
+
+static void
+x11_host_connect(void)
+{
+   xcb_connection_t *conn = xcb_connect(x11_host_display(), NULL);
+   if (xcb_connection_has_error(conn)) {
+      mesa_loge("SteamPSP: cannot connect to host display %s", x11_host_display());
+      xcb_disconnect(conn);
+      conn = NULL;
+   }
+   x11_host_conn = conn;
+}
+
+/* One connection per process, shared by all swapchains and never closed. */
+static xcb_connection_t *
+x11_host_connection(void)
+{
+   call_once(&x11_host_once, x11_host_connect);
+   return x11_host_conn;
+}
+
+/* The present thread tracks the surface window on a connection of its own,
+ * so it never makes round trips on the application's connection, which may
+ * belong to Xlib and be in use on another thread. */
+static xcb_connection_t *x11_host_track_conn;
+static once_flag x11_host_track_once = ONCE_FLAG_INIT;
+
+static void
+x11_host_track_connect(void)
+{
+   xcb_connection_t *conn = xcb_connect(NULL, NULL);
+   if (xcb_connection_has_error(conn)) {
+      xcb_disconnect(conn);
+      conn = NULL;
+   }
+   x11_host_track_conn = conn;
+}
+
+/* One round trip: the surface server has a single screen. */
+static bool
+x11_host_query(xcb_connection_t *conn, xcb_window_t window,
+               struct x11_host_geometry *out)
+{
+   xcb_window_t root = xcb_setup_roots_iterator(xcb_get_setup(conn)).data->root;
+   xcb_get_geometry_cookie_t geometry_cookie = xcb_get_geometry(conn, window);
+   xcb_get_window_attributes_cookie_t attributes_cookie =
+      xcb_get_window_attributes(conn, window);
+   xcb_translate_coordinates_cookie_t origin_cookie =
+      xcb_translate_coordinates(conn, window, root, 0, 0);
+   xcb_get_geometry_reply_t *geometry =
+      xcb_get_geometry_reply(conn, geometry_cookie, NULL);
+   xcb_get_window_attributes_reply_t *attributes =
+      xcb_get_window_attributes_reply(conn, attributes_cookie, NULL);
+   xcb_translate_coordinates_reply_t *origin =
+      xcb_translate_coordinates_reply(conn, origin_cookie, NULL);
+   bool ok = geometry && attributes && origin;
+   if (ok) {
+      out->x = origin->dst_x;
+      out->y = origin->dst_y;
+      out->width = MAX2(geometry->width, 1);
+      out->height = MAX2(geometry->height, 1);
+      out->viewable = attributes->map_state == XCB_MAP_STATE_VIEWABLE;
+   }
+   free(geometry);
+   free(attributes);
+   free(origin);
+   return ok;
+}
+
+static xcb_atom_t
+x11_host_atom(xcb_connection_t *conn, const char *name)
+{
+   xcb_intern_atom_reply_t *reply =
+      xcb_intern_atom_reply(conn, xcb_intern_atom(conn, 0, strlen(name), name), NULL);
+   xcb_atom_t atom = reply ? reply->atom : XCB_ATOM_NONE;
+   free(reply);
+   return atom;
+}
+
+/* The surface window's painter's order on its own server: its 1-based sibling index (bottom
+ * first) under each ancestor, from the root down. Children paint above their parent, so the
+ * lexicographic order of these keys is the surface server's stacking order. Returns the key
+ * length, 0 on failure. */
+static uint32_t
+x11_host_stack_key(xcb_connection_t *conn, xcb_window_t window, uint32_t *key)
+{
+   uint32_t reversed[XRGAME_STACK_DEPTH];
+   uint32_t depth = 0;
+   bool ok = true;
+   xcb_query_tree_reply_t *tree =
+      xcb_query_tree_reply(conn, xcb_query_tree(conn, window), NULL);
+   if (!tree)
+      return 0;
+   while (tree->parent != XCB_WINDOW_NONE && depth < XRGAME_STACK_DEPTH) {
+      xcb_window_t parent = tree->parent;
+      free(tree);
+      /* The parent's reply lists this window's siblings and names the next ancestor. */
+      tree = xcb_query_tree_reply(conn, xcb_query_tree(conn, parent), NULL);
+      if (!tree) {
+         ok = false;
+         break;
+      }
+      const xcb_window_t *children = xcb_query_tree_children(tree);
+      int count = xcb_query_tree_children_length(tree);
+      uint32_t index = 0;
+      for (int i = 0; i < count; i++) {
+         if (children[i] == window) {
+            index = i + 1;
+            break;
+         }
+      }
+      reversed[depth++] = index;
+      window = parent;
+   }
+   free(tree);
+   if (!ok)
+      return 0;
+   for (uint32_t i = 0; i < depth; i++)
+      key[i] = reversed[depth - 1 - i];
+   return depth;
+}
+
+/* The host keeps windows with this property above its other windows, in key order. */
+static void
+x11_host_publish_key(xcb_connection_t *conn, xcb_window_t window, const uint32_t *key,
+                     uint32_t len)
+{
+   static xcb_atom_t atom;
+   if (!atom)
+      atom = x11_host_atom(conn, "_XRGAME_STACK_KEY");
+   if (atom != XCB_ATOM_NONE && len)
+      xcb_change_property(conn, XCB_PROP_MODE_REPLACE, window, atom, XCB_ATOM_CARDINAL, 32,
+                          len, key);
+}
+
+static VkResult
+x11_host_window_create(xcb_connection_t *surface_conn, xcb_window_t surface_window,
+                       xcb_connection_t **conn_out, xcb_window_t *window_out,
+                       uint32_t *depth_out, struct x11_host_geometry *geometry)
+{
+   xcb_connection_t *conn = x11_host_connection();
+   if (!conn || !x11_host_query(surface_conn, surface_window, geometry))
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   xcb_screen_t *screen = xcb_setup_roots_iterator(xcb_get_setup(conn)).data;
+   xcb_window_t window = xcb_generate_id(conn);
+   /* Value order follows the mask bit order. */
+   const uint32_t values[] = { XCB_BACK_PIXMAP_NONE, 1 };
+   xcb_void_cookie_t cookie =
+      xcb_create_window_checked(conn, screen->root_depth, window, screen->root,
+                                geometry->x, geometry->y,
+                                geometry->width, geometry->height, 0,
+                                XCB_WINDOW_CLASS_INPUT_OUTPUT, screen->root_visual,
+                                XCB_CW_BACK_PIXMAP | XCB_CW_OVERRIDE_REDIRECT, values);
+   xcb_generic_error_t *error = xcb_request_check(conn, cookie);
+   if (error) {
+      free(error);
+      return VK_ERROR_SURFACE_LOST_KHR;
+   }
+
+   const uint32_t passthrough = 1;
+   xcb_atom_t atom = x11_host_atom(conn, "_XRGAME_INPUT_PASSTHROUGH");
+   if (atom != XCB_ATOM_NONE)
+      xcb_change_property(conn, XCB_PROP_MODE_REPLACE, window, atom,
+                          XCB_ATOM_CARDINAL, 32, 1, &passthrough);
+   static const char name[] = "steampsp-gpu-surface";
+   xcb_change_property(conn, XCB_PROP_MODE_REPLACE, window, XCB_ATOM_WM_NAME,
+                       XCB_ATOM_STRING, 8, strlen(name), name);
+   uint32_t key[XRGAME_STACK_DEPTH];
+   x11_host_publish_key(conn, window, key, x11_host_stack_key(surface_conn, surface_window, key));
+   if (geometry->viewable)
+      xcb_map_window(conn, window);
+   xcb_flush(conn);
+
+   *conn_out = conn;
+   *window_out = window;
+   *depth_out = screen->root_depth;
+   return VK_SUCCESS;
+}
+
+/* $DISPLAY's connection when it reaches the surface server: the window must
+ * report the geometry the application's connection just did. Otherwise the
+ * host window stays where it was created. */
+static xcb_connection_t *
+x11_host_tracking_connection(xcb_window_t surface_window,
+                             const struct x11_host_geometry *expected)
+{
+   call_once(&x11_host_track_once, x11_host_track_connect);
+   struct x11_host_geometry geometry;
+   if (!x11_host_track_conn ||
+       !x11_host_query(x11_host_track_conn, surface_window, &geometry) ||
+       geometry.x != expected->x || geometry.y != expected->y ||
+       geometry.width != expected->width || geometry.height != expected->height)
+      return NULL;
+   return x11_host_track_conn;
+}
+
+/* Called on the present thread before each Present. Keeps the host window at the surface
+ * window's place, and its stacking key current: the surface server can restack windows
+ * without moving them (a popup raised over the page), so the key is refreshed on every
+ * change and every 30th present. */
+static void
+x11_host_track(struct x11_swapchain *chain, bool *resized)
+{
+   struct x11_host_geometry geometry;
+   *resized = false;
+   if (!chain->track_conn ||
+       !x11_host_query(chain->track_conn, chain->surface_window, &geometry))
+      return;
+
+   *resized = geometry.width != chain->extent.width ||
+              geometry.height != chain->extent.height;
+   bool moved = geometry.x != chain->host_geometry.x ||
+                geometry.y != chain->host_geometry.y ||
+                geometry.width != chain->host_geometry.width ||
+                geometry.height != chain->host_geometry.height;
+   if (geometry.viewable && (!chain->host_mapped || moved)) {
+      const uint32_t values[] = { (uint32_t)(int32_t)geometry.x,
+                                  (uint32_t)(int32_t)geometry.y,
+                                  geometry.width, geometry.height };
+      xcb_configure_window(chain->conn, chain->window,
+                           XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y |
+                           XCB_CONFIG_WINDOW_WIDTH | XCB_CONFIG_WINDOW_HEIGHT, values);
+   }
+   if (moved || geometry.viewable != chain->host_mapped || chain->host_presents++ % 30 == 0) {
+      uint32_t key[XRGAME_STACK_DEPTH];
+      uint32_t len = x11_host_stack_key(chain->track_conn, chain->surface_window, key);
+      if (len && (len != chain->host_key_len ||
+                  memcmp(key, chain->host_key, len * sizeof(*key)) != 0)) {
+         x11_host_publish_key(chain->conn, chain->window, key, len);
+         memcpy(chain->host_key, key, len * sizeof(*key));
+         chain->host_key_len = len;
+      }
+   }
+   if (geometry.viewable != chain->host_mapped) {
+      if (geometry.viewable)
+         xcb_map_window(chain->conn, chain->window);
+      else
+         xcb_unmap_window(chain->conn, chain->window);
+   }
+   chain->host_geometry = geometry;
+   chain->host_mapped = geometry.viewable;
+}
+
+/* The application renders into an ordinary image, and each present copies it into a buffer
+ * on the host's memory. An image cannot sit on that memory directly: Turnip pads a linear
+ * image's last level to a multiple of four rows (fdl6_layout_image, for the over-fetch of
+ * the 16x4 GMEM blits), and gralloc's buffer has only the rows it was asked for, so a
+ * 722-row window needed 9 KiB more than its buffer held. A buffer's size is exact. */
+static VkResult
+x11_host_create_mem(const struct wsi_swapchain *chain,
+                    const struct wsi_image_info *info,
+                    struct wsi_image *base)
+{
+   struct x11_image *image = (struct x11_image *)base;
+   const struct wsi_device *wsi = chain->wsi;
+   VK_FROM_HANDLE(vk_device, device, chain->device);
+   if (image->host_fd < 0)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   const VkExternalMemoryBufferCreateInfo external = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .pNext = &external,
+      .size = info->linear_size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkResult result = wsi->CreateBuffer(chain->device, &buffer_info, &chain->alloc,
+                                       &base->blit.buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkMemoryRequirements requirements;
+   wsi->GetBufferMemoryRequirements(chain->device, base->blit.buffer, &requirements);
+   VkMemoryFdPropertiesKHR properties = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+   };
+   result = device->dispatch_table.GetMemoryFdPropertiesKHR(
+      chain->device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      image->host_fd, &properties);
+   if (result != VK_SUCCESS)
+      return result;
+   uint32_t types = properties.memoryTypeBits & requirements.memoryTypeBits;
+   off_t size = lseek(image->host_fd, 0, SEEK_END);
+   if (!types || size < 0 || (uint64_t)size < requirements.size) {
+      mesa_loge("SteamPSP: host buffer of %lld bytes (types 0x%x) for a %llu-byte copy",
+                (long long)size, properties.memoryTypeBits,
+                (unsigned long long)requirements.size);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   VkImportMemoryFdInfoKHR import = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = image->host_fd,
+   };
+   VkMemoryDedicatedAllocateInfo buffer_dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &import,
+      .buffer = base->blit.buffer,
+   };
+   VkMemoryAllocateInfo buffer_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &buffer_dedicated,
+      .allocationSize = size,
+      .memoryTypeIndex = ffs(types) - 1,
+   };
+   result = wsi->AllocateMemory(chain->device, &buffer_allocate, &chain->alloc,
+                                &base->blit.memory);
+   if (result != VK_SUCCESS)
+      return result;
+   /* A successful import owns the fd. */
+   image->host_fd = -1;
+   result = wsi->BindBufferMemory(chain->device, base->blit.buffer, base->blit.memory, 0);
+   if (result != VK_SUCCESS)
+      return result;
+   /* The host's renderer reads the buffer on its own device. */
+   base->blit.to_foreign_queue = true;
+
+   wsi->GetImageMemoryRequirements(chain->device, base->image, &requirements);
+   const VkMemoryDedicatedAllocateInfo image_dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = base->image,
+   };
+   const VkMemoryAllocateInfo image_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &image_dedicated,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex = info->select_image_memory_type(wsi, requirements.memoryTypeBits),
+   };
+   result = wsi->AllocateMemory(chain->device, &image_allocate, &chain->alloc, &base->memory);
+   if (result != VK_SUCCESS)
+      return result;
+
+   base->num_planes = 1;
+   base->sizes[0] = info->linear_size;
+   base->row_pitches[0] = info->linear_stride;
+   base->offsets[0] = 0;
+   return VK_SUCCESS;
+}
+
+VkResult
+wsi_x11_configure_host_image(const struct wsi_swapchain *chain,
+                             const VkSwapchainCreateInfoKHR *info,
+                             struct wsi_image_info *image_info)
+{
+   VkResult result = wsi_configure_image(chain, info, 0, image_info);
+   if (result != VK_SUCCESS)
+      return result;
+   /* The copy's stride and size are the host buffer's, set per image in
+    * x11_host_image_init. */
+   wsi_configure_buffer_image(chain, info, 1, 1, image_info);
+   image_info->image_type = WSI_IMAGE_TYPE_XRGAME_HOST;
+   image_info->color_space = info->imageColorSpace;
+   image_info->create_mem = x11_host_create_mem;
+   image_info->select_image_memory_type = wsi_select_device_memory_type;
+   return VK_SUCCESS;
+}
+
+/* Receive the flattened GraphicBuffer; keep its first fd (the dma-buf). */
+static bool
+x11_host_receive(int socket, uint32_t width, uint32_t height,
+                 int *fd_out, uint32_t *stride_out)
+{
+   int32_t data[XRGAME_GB01_HEADER + XRGAME_GB01_MAX_INTS];
+   char control[CMSG_SPACE(sizeof(int) * XRGAME_HOST_MAX_FDS)];
+   struct iovec iov = { .iov_base = data, .iov_len = sizeof(data) };
+   struct msghdr msg = {
+      .msg_iov = &iov, .msg_iovlen = 1,
+      .msg_control = control, .msg_controllen = sizeof(control),
+   };
+   struct pollfd poll_fd = { .fd = socket, .events = POLLIN };
+   if (poll(&poll_fd, 1, 5000) <= 0)
+      return false;
+   ssize_t length;
+   do {
+      length = recvmsg(socket, &msg, MSG_CMSG_CLOEXEC);
+   } while (length < 0 && errno == EINTR);
+
+   int fds[XRGAME_HOST_MAX_FDS];
+   int fd_count = 0;
+   for (struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg); cmsg; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+      if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS)
+         continue;
+      int count = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+      for (int i = 0; i < count && fd_count < XRGAME_HOST_MAX_FDS; i++)
+         memcpy(&fds[fd_count++], CMSG_DATA(cmsg) + i * sizeof(int), sizeof(int));
+   }
+   bool ok = length >= (ssize_t)(XRGAME_GB01_HEADER * sizeof(int32_t)) &&
+             !(msg.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) &&
+             data[0] == XRGAME_GB01 &&
+             (uint32_t)data[1] == width && (uint32_t)data[2] == height &&
+             data[3] >= (int32_t)width && data[5] == 1 &&
+             data[10] >= 1 && data[10] == fd_count;
+   for (int i = ok ? 1 : 0; i < fd_count; i++)
+      close(fds[i]);
+   if (!ok) {
+      mesa_loge("SteamPSP: invalid host buffer for %ux%u", width, height);
+      return false;
+   }
+   *fd_out = fds[0];
+   *stride_out = data[3];
+   return true;
+}
+
+static VkResult
+x11_host_image_init(struct x11_swapchain *chain, struct x11_image *image)
+{
+   uint32_t format;
+   switch (chain->base.image_info.create.format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      format = 5; /* HAL_PIXEL_FORMAT_BGRA_8888 */
+      break;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      format = 1; /* AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM */
+      break;
+   default:
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+
+   int sockets[2];
+   if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets))
+      return VK_ERROR_INITIALIZATION_FAILED;
+   image->host_fd = -1;
+   image->pixmap = xcb_generate_id(chain->conn);
+   xcb_void_cookie_t cookie = xcb_dri3_pixmap_from_buffers_checked(
+      chain->conn, image->pixmap, chain->window, 1,
+      chain->extent.width, chain->extent.height,
+      0, format, 0, 0, 0, 0, 0, 0,
+      chain->depth, 32, XRGAME_HOST_AHB_MODIFIER, &sockets[1]);
+   xcb_flush(chain->conn);
+   uint32_t stride = 0;
+   bool received = x11_host_receive(sockets[0], chain->extent.width,
+                                    chain->extent.height, &image->host_fd, &stride);
+   close(sockets[0]);
+   xcb_generic_error_t *error = xcb_request_check(chain->conn, cookie);
+   if (!received || error) {
+      free(error);
+      goto fail;
+   }
+
+   /* A copy of the shared create info gives this image's copy the host's pitch. */
+   struct wsi_image_info info = chain->base.image_info;
+   info.linear_stride = stride * 4;
+   info.linear_size = (uint64_t)info.linear_stride * chain->extent.height;
+   VkResult result = wsi_create_image(&chain->base, &info, &image->base);
+   if (result != VK_SUCCESS)
+      goto fail;
+   image->update_region = None;
+   return VK_SUCCESS;
+
+fail:
+   if (image->host_fd >= 0)
+      close(image->host_fd);
+   image->host_fd = -1;
+   xcb_free_pixmap(chain->conn, image->pixmap);
+   image->pixmap = 0;
+   return VK_ERROR_INITIALIZATION_FAILED;
+}
