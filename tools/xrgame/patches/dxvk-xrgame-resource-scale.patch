     D3D10DepthStencilView* GetD3D10Iface() {
       return &m_d3d10;
     }
@@ -84,6 +92,8 @@ namespace dxvk {
     Rc<DxvkImageView>                 m_view;
     D3D10DepthStencilView             m_d3d10;
 
