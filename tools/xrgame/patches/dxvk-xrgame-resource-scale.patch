+    ScaleTag loadScaleTag(dxbc_spv::ir::SsaDef ref, dxbc_spv::ir::SsaDef pushDataVar, uint32_t member, dxbc_spv::ir::SsaDef mip) {
+      using namespace dxbc_spv::ir;
+
