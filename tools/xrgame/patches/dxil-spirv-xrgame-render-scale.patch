+/* XRGame render scale. Render and depth targets may live in images smaller than the application
+ * created them. The raw VA aux buffer holds a tag for each heap entry that views such a 2D texture:
+ * x = width | height << 16 of the application's view, y = 0x585247 << 8 | scale in eighths.
+ * Texel loads, stores and size queries of tagged textures are remapped. SV_Position is divided by
+ * the pass scale (in eighths, 0 meaning unscaled) held in root constant word pass_scale_word,
+ * counted after the root descriptors, or left alone when it is ~0u. For diagnosis, flags can leave
+ * out the texel mapping (DXIL_SPV_XRGAME_RENDER_SCALE_NO_TEXEL_MAPPING) or the size queries
+ * (DXIL_SPV_XRGAME_RENDER_SCALE_NO_SIZE_QUERY). */
+#define DXIL_SPV_XRGAME_RENDER_SCALE_NO_TEXEL_MAPPING 0x1u
+#define DXIL_SPV_XRGAME_RENDER_SCALE_NO_SIZE_QUERY 0x2u
+typedef struct dxil_spv_option_xrgame_render_scale
+{
+	dxil_spv_option_base base;
+	dxil_spv_bool enabled;
+	unsigned aux_desc_set;
+	unsigned aux_binding;
+	unsigned pass_scale_word;
+	unsigned flags;
+} dxil_spv_option_xrgame_render_scale;
