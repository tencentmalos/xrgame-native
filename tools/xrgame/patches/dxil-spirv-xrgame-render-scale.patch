+// XRGame render scale: the factor that takes SV_Position of a pass into scaled targets back to the
+// coordinates of the targets the application created, or 0 when the pass scale is not available.
+static spv::Id build_xrgame_frag_coord_factor(Converter::Impl &impl)
+{
+	auto &builder = impl.builder();
+	unsigned word = impl.options.xrgame_render_scale.pass_scale_word;
+
+	if (word == ~0u || impl.root_constant_id == 0 || word >= impl.root_constant_num_words)
+		return 0;
+
+	auto *chain = impl.allocate(
+	    spv::OpAccessChain,
+	    builder.makePointer(impl.options.inline_ubo_enable ? spv::StorageClassUniform : spv::StorageClassPushConstant,
+	                        builder.makeUintType(32)));
+	chain->add_id(impl.root_constant_id);
+	if (impl.root_constant_arrayed)
+	{
+		chain->add_id(builder.makeUintConstant(impl.root_descriptor_count));
+		chain->add_id(builder.makeUintConstant(word));
+	}
+	else
+		chain->add_id(builder.makeUintConstant(word + impl.root_descriptor_count));
+	impl.add(chain);
+
+	auto *eighths = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+	eighths->add_id(chain->id);
+	impl.add(eighths);
+
+	// 0 means the pass is not scaled.
+	auto *unscaled = impl.allocate(spv::OpIEqual, builder.makeBoolType());
+	unscaled->add_id(eighths->id);
+	unscaled->add_id(builder.makeUintConstant(0));
+	impl.add(unscaled);
+
+	auto *effective = impl.allocate(spv::OpSelect, builder.makeUintType(32));
+	effective->add_id(unscaled->id);
+	effective->add_id(builder.makeUintConstant(8));
+	effective->add_id(eighths->id);
+	impl.add(effective);
+
+	auto *as_float = impl.allocate(spv::OpConvertUToF, builder.makeFloatType(32));
+	as_float->add_id(effective->id);
+	impl.add(as_float);
+
+	auto *factor = impl.allocate(spv::OpFDiv, builder.makeFloatType(32));
+	factor->add_id(builder.makeFloatConstant(8.0f));
+	factor->add_id(as_float->id);
+	impl.add(factor);
+	return factor->id;
+}
