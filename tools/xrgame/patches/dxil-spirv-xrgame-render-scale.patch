+	auto *actual_xy = impl.allocate(spv::OpVectorShuffle, uvec2_type);
+	actual_xy->add_id(size_op->id);
+	actual_xy->add_id(size_op->id);
+	actual_xy->add_literal(0);
+	actual_xy->add_literal(1);
+	impl.add(actual_xy);
+
+	spv::Id conditions[2] = { scaled_id, scaled_id };
+	auto *select = impl.allocate(spv::OpSelect, uvec2_type);
+	select->add_id(impl.build_vector(builder.makeBoolType(), conditions, 2));
+	select->add_id(requested_size_id);
+	select->add_id(actual_xy->id);
+	impl.add(select);
+
+	if (num_coords == 2)
+		return select;
+
+	auto *merged = impl.allocate(spv::OpVectorShuffle, impl.build_vector_type(uint_type, num_coords));
+	merged->add_id(select->id);
+	merged->add_id(size_op->id);
+	merged->add_literal(0);
+	merged->add_literal(1);
+	merged->add_literal(4);
+	impl.add(merged);
+	return merged;
+}
