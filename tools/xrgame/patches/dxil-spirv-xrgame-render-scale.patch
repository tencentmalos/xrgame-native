+// XRGame render scale. vkd3d tags the heap entries that view a 2D texture rendered at a reduced
+// size: its raw VA aux slot holds x = width | height << 16 of the view the application asked for and
+// y = 0x585247 << 8 | scale in eighths. As in shadPS4, integer texel coordinates are mapped to
+// floor((c + 0.5) * actual / requested), and size queries return the requested size.
+static constexpr uint32_t XRGameTagMagic = 0x585247u;
+
+static bool xrgame_image_is_mapped(Converter::Impl &impl, const Converter::Impl::ResourceMeta &meta,
+                                   spv::Id image_type_id)
+{
+	auto &builder = impl.builder();
+	return meta.xrgame_heap_index_id != 0 && builder.getTypeDimensionality(image_type_id) == spv::Dim2D &&
+	       !builder.isMultisampledImageType(image_type_id);
+}
+
+// Whether the texture is scaled, and its requested width and height at mip lod_id of the view
+// (the view's own base when lod_id is 0).
+static bool build_xrgame_texture_scale(Converter::Impl &impl, const Converter::Impl::ResourceMeta &meta,
+                                       spv::Id lod_id, spv::Id &scaled_id, spv::Id &requested_size_id)
+{
+	auto &builder = impl.builder();
+	spv::Id uint_type = builder.makeUintType(32);
+	spv::Id uvec2_type = builder.makeVectorType(uint_type, 2);
+
+	if (!impl.xrgame_aux_var_id)
+	{
+		Converter::Impl::BindlessInfo info = {};
+		info.type = DXIL::ResourceType::UAV;
+		info.component = DXIL::ComponentType::U32;
+		info.kind = DXIL::ResourceKind::Invalid;
+		info.counters = true;
+		info.desc_set = impl.options.xrgame_render_scale.aux_desc_set;
+		info.binding = impl.options.xrgame_render_scale.aux_binding;
+		impl.xrgame_aux_var_id = impl.create_bindless_heap_variable(info);
+	}
+
+	// The descriptor heap introspection buffer has another layout; vkd3d does not map counters to it here.
+	if (!impl.xrgame_aux_var_id ||
+	    impl.xrgame_aux_var_id == impl.instrumentation.descriptor_heap_introspection_var_id)
+		return false;
+
+	auto *chain = impl.allocate(spv::OpAccessChain, builder.makePointer(spv::StorageClassStorageBuffer, uvec2_type));
+	chain->add_id(impl.xrgame_aux_var_id);
+	chain->add_id(builder.makeUintConstant(0));
+	chain->add_id(meta.xrgame_heap_index_id);
+	impl.add(chain);
+
+	auto *tag = impl.allocate(spv::OpLoad, uvec2_type);
+	tag->add_id(chain->id);
+	impl.add(tag);
+
+	auto *tag_x = impl.allocate(spv::OpCompositeExtract, uint_type);
+	tag_x->add_id(tag->id);
+	tag_x->add_literal(0);
+	impl.add(tag_x);
+
+	auto *tag_y = impl.allocate(spv::OpCompositeExtract, uint_type);
+	tag_y->add_id(tag->id);
+	tag_y->add_literal(1);
+	impl.add(tag_y);
+
+	auto *magic = impl.allocate(spv::OpShiftRightLogical, uint_type);
+	magic->add_id(tag_y->id);
+	magic->add_id(builder.makeUintConstant(8));
+	impl.add(magic);
+
+	auto *is_scaled = impl.allocate(spv::OpIEqual, builder.makeBoolType());
+	is_scaled->add_id(magic->id);
+	is_scaled->add_id(builder.makeUintConstant(XRGameTagMagic));
+	impl.add(is_scaled);
+
+	auto *width = impl.allocate(spv::OpBitwiseAnd, uint_type);
+	width->add_id(tag_x->id);
+	width->add_id(builder.makeUintConstant(0xffff));
+	impl.add(width);
+
+	auto *height = impl.allocate(spv::OpShiftRightLogical, uint_type);
+	height->add_id(tag_x->id);
+	height->add_id(builder.makeUintConstant(16));
+	impl.add(height);
+
+	spv::Id size[2] = { width->id, height->id };
+	spv::Id size_id = impl.build_vector(uint_type, size, 2);
+
+	if (lod_id)
+	{
+		spv::Id lods[2] = { lod_id, lod_id };
+		auto *shifted = impl.allocate(spv::OpShiftRightLogical, uvec2_type);
+		shifted->add_id(size_id);
+		shifted->add_id(impl.build_vector(uint_type, lods, 2));
+		impl.add(shifted);
+
+		if (!impl.glsl_std450_ext)
+			impl.glsl_std450_ext = builder.import("GLSL.std.450");
+
+		auto *at_least_one = impl.allocate(spv::OpExtInst, uvec2_type);
+		at_least_one->add_id(impl.glsl_std450_ext);
+		at_least_one->add_literal(GLSLstd450UMax);
+		at_least_one->add_id(shifted->id);
+		at_least_one->add_id(impl.build_splat_constant_vector(uint_type, builder.makeUintConstant(1), 2));
+		impl.add(at_least_one);
+		size_id = at_least_one->id;
+	}
+
+	scaled_id = is_scaled->id;
+	requested_size_id = size_id;
+	return true;
+}
+
+// Maps x and y of the integer texel coordinate coord_id (num_coords components) of a load or store.
+static spv::Id build_xrgame_map_texel_coord(Converter::Impl &impl, const Converter::Impl::ResourceMeta &meta,
+                                            spv::Id image_id, bool is_uav, spv::Id lod_id,
+                                            spv::Id coord_id, unsigned num_coords, bool coord_is_signed)
+{
+	auto &builder = impl.builder();
+	spv::Id scaled_id, requested_size_id;
+
+	if (!build_xrgame_texture_scale(impl, meta, lod_id, scaled_id, requested_size_id))
+		return coord_id;
+
+	spv::Id uint_type = builder.makeUintType(32);
+	spv::Id int_type = builder.makeIntType(32);
+	spv::Id float_type = builder.makeFloatType(32);
+	spv::Id uvec2_type = builder.makeVectorType(uint_type, 2);
+	spv::Id ivec2_type = builder.makeVectorType(int_type, 2);
+	spv::Id vec2_type = builder.makeVectorType(float_type, 2);
+	spv::Id coord_component_type = coord_is_signed ? int_type : uint_type;
+	spv::Id coord_xy_type = coord_is_signed ? ivec2_type : uvec2_type;
+
+	auto *actual_size = impl.allocate(is_uav ? spv::OpImageQuerySize : spv::OpImageQuerySizeLod,
+	                                  impl.build_vector_type(uint_type, num_coords));
+	actual_size->add_id(image_id);
+	if (!is_uav)
+		actual_size->add_id(lod_id ? lod_id : builder.makeUintConstant(0));
+	impl.add(actual_size);
+	builder.addCapability(spv::CapabilityImageQuery);
+
+	auto *actual_xy = impl.allocate(spv::OpVectorShuffle, uvec2_type);
+	actual_xy->add_id(actual_size->id);
+	actual_xy->add_id(actual_size->id);
+	actual_xy->add_literal(0);
+	actual_xy->add_literal(1);
+	impl.add(actual_xy);
+
+	auto *coord_xy = impl.allocate(spv::OpVectorShuffle, coord_xy_type);
+	coord_xy->add_id(coord_id);
+	coord_xy->add_id(coord_id);
+	coord_xy->add_literal(0);
+	coord_xy->add_literal(1);
+	impl.add(coord_xy);
+
+	spv::Id signed_xy_id = coord_xy->id;
+	if (!coord_is_signed)
+	{
+		auto *cast = impl.allocate(spv::OpBitcast, ivec2_type);
+		cast->add_id(coord_xy->id);
+		impl.add(cast);
+		signed_xy_id = cast->id;
+	}
+
+	auto *coord_f = impl.allocate(spv::OpConvertSToF, vec2_type);
+	coord_f->add_id(signed_xy_id);
+	impl.add(coord_f);
+
+	auto *center = impl.allocate(spv::OpFAdd, vec2_type);
+	center->add_id(coord_f->id);
+	center->add_id(impl.build_splat_constant_vector(float_type, builder.makeFloatConstant(0.5f), 2));
+	impl.add(center);
+
+	auto *actual_f = impl.allocate(spv::OpConvertUToF, vec2_type);
+	actual_f->add_id(actual_xy->id);
+	impl.add(actual_f);
+
+	auto *requested_f = impl.allocate(spv::OpConvertUToF, vec2_type);
+	requested_f->add_id(requested_size_id);
+	impl.add(requested_f);
+
+	auto *scaled = impl.allocate(spv::OpFMul, vec2_type);
+	scaled->add_id(center->id);
+	scaled->add_id(actual_f->id);
+	impl.add(scaled);
+
+	auto *ratio = impl.allocate(spv::OpFDiv, vec2_type);
+	ratio->add_id(scaled->id);
+	ratio->add_id(requested_f->id);
+	impl.add(ratio);
+
+	if (!impl.glsl_std450_ext)
+		impl.glsl_std450_ext = builder.import("GLSL.std.450");
+
+	auto *floored = impl.allocate(spv::OpExtInst, vec2_type);
+	floored->add_id(impl.glsl_std450_ext);
+	floored->add_literal(GLSLstd450Floor);
+	floored->add_id(ratio->id);
+	impl.add(floored);
+
+	auto *mapped = impl.allocate(spv::OpConvertFToS, ivec2_type);
+	mapped->add_id(floored->id);
+	impl.add(mapped);
+
+	spv::Id mapped_id = mapped->id;
+	if (!coord_is_signed)
+	{
+		auto *cast = impl.allocate(spv::OpBitcast, uvec2_type);
+		cast->add_id(mapped->id);
+		impl.add(cast);
+		mapped_id = cast->id;
+	}
+
