+// Replaces x and y of the size query size_op (num_coords components) with the requested size.
+static Operation *build_xrgame_requested_size(Converter::Impl &impl, Operation *size_op, unsigned num_coords,
+                                              spv::Id scaled_id, spv::Id requested_size_id)
+{
+	auto &builder = impl.builder();
+	spv::Id uint_type = builder.makeUintType(32);
+	spv::Id uvec2_type = builder.makeVectorType(uint_type, 2);
