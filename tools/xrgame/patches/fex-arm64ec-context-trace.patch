+// Private diagnostic build only: trace one configured guest RIP, 64 events total.
+// Loader callbacks can run before PE TLS exists; do not use thread_local here.
+uint64_t XrGameTraceRip {};
+std::atomic<DWORD> XrGameTraceTid {};
+std::atomic<unsigned> XrGameTraceRemaining {64};
+static void XrGameContextTrace(const char* Event, uint64_t Address = 0) {
+  const DWORD Tid = GetCurrentThreadId();
+  if (XrGameTraceTid.load(std::memory_order_relaxed) != Tid) return;
+  unsigned Remaining = XrGameTraceRemaining.load(std::memory_order_relaxed);
+  while (Remaining && !XrGameTraceRemaining.compare_exchange_weak(Remaining, Remaining - 1, std::memory_order_relaxed)) {}
+  if (Remaining) LogMan::Msg::IFmt("XRGameContext event={} tid={:X} address={:X}", Event, Tid, Address);
+}
