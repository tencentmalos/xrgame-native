diff --git a/helpers/pe_helpers.cpp b/helpers/pe_helpers.cpp
index da97b6a..f34dbcd 100644
--- a/helpers/pe_helpers.cpp
+++ b/helpers/pe_helpers.cpp
@@ -4,6 +4,7 @@
 #include <utility>
 #include <mutex>
 #include <cwchar>
+#include <tlhelp32.h>
 
 static inline bool is_hex(const char c)
 {
@@ -363,9 +364,34 @@ DWORD pe_helpers::loadlib_remote(HANDLE hProcess, const std::string &fullpath, c
         return GetLastError();
     }
 
-    // wait for DllMain
-    WaitForSingleObject(remote_thread, INFINITE);
+    // A thread exit is a DWORD, not an HMODULE. A truncated 64-bit module handle
+    // can be zero, while an exception status is nonzero. Verify the loaded module.
+    DWORD wait_result = WaitForSingleObject(remote_thread, INFINITE);
+    DWORD inject_error = wait_result == WAIT_OBJECT_0 ? ERROR_SUCCESS : GetLastError();
+    if (wait_result != WAIT_OBJECT_0 && !inject_error) inject_error = ERROR_GEN_FAILURE;
+    DWORD process_exit = STILL_ACTIVE;
+    if (!inject_error && !GetExitCodeProcess(hProcess, &process_exit)) inject_error = GetLastError();
+    if (!inject_error && process_exit != STILL_ACTIVE) inject_error = ERROR_PROCESS_ABORTED;
     CloseHandle(remote_thread);
+    if (!inject_error) {
+        HANDLE snapshot = INVALID_HANDLE_VALUE;
+        for (unsigned retry = 0; retry < 5; ++retry) {
+            snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | TH32CS_SNAPMODULE32, GetProcessId(hProcess));
+            if (snapshot != INVALID_HANDLE_VALUE || GetLastError() != ERROR_BAD_LENGTH) break;
+            Sleep(1);
+        }
+        if (snapshot == INVALID_HANDLE_VALUE) inject_error = GetLastError();
+        else {
+            MODULEENTRY32W module{};
+            module.dwSize = sizeof(module);
+            bool loaded = false;
+            if (Module32FirstW(snapshot, &module)) do {
+                if (!_wcsicmp(module.szExePath, lib_fullpath.c_str())) { loaded = true; break; }
+            } while (Module32NextW(snapshot, &module));
+            CloseHandle(snapshot);
+            if (!loaded) inject_error = ERROR_DLL_INIT_FAILED;
+        }
+    }
 
     // cleanup allcoated page
     VirtualFreeEx(
@@ -375,7 +401,8 @@ DWORD pe_helpers::loadlib_remote(HANDLE hProcess, const std::string &fullpath, c
         MEM_RELEASE
     );
 
-    return ERROR_SUCCESS;
+    if (inject_error && err_reason) *err_reason = "Remote LoadLibraryW did not leave the requested module loaded in a live process";
+    return inject_error;
 }
 
